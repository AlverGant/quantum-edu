{
  "name": "quantum-edu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm test && npm run typecheck && wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute quantum_edu --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute quantum_edu --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.121.0"
  }
}
